---
title: "DevSage Team — Platform Admin User Flow"
---

flowchart TD
    %% ── Workspace Provisioning ──────────────
    subgraph PROVISION["Workspace Provisioning"]
        P1[College/club reaches out]
        P2[Log into Admin Dashboard]
        P3[Create Workspace]
        P4[Invite Club President as Owner]
        P5[Monitor invite acceptance]
    end

    P1 --> P2 --> P3 --> P4 --> P5

    %% ── Hackathon Request Review ────────────
    subgraph REVIEW["Hackathon Request Review"]
        R1[Admin submits hackathon request]
        R2[Request appears on Admin Dashboard]
        R3[Review basics]
        R4{Approve?}
        R5[Reject with reason]
        R6["Backend auto-creates:
- Hackathon in draft state
- DO state machine initialized
- Slugs & IDs generated
- Audit event logged"]
    end

    R1 -.->|Request pipeline| R2
    R2 --> R3 --> R4
    R4 -->|No| R5
    R4 -->|Yes| R6

    %% ── Theming ─────────────────────────────
    subgraph THEME["Hackathon Theming"]
        TH1["Upload logo, set brand colors"]
        TH2["Configure sponsor content"]
        TH3["Review & QA"]
        TH4["Custom domain setup (optional)"]
        TH5["Notify Event Leads — ready"]
    end

    R6 --> TH1 --> TH2 --> TH3 --> TH4 --> TH5

    %% ── Handoff ─────────────────────────────
    subgraph HANDOFF["Handoff to Event Leads"]
        H1["Event Leads configure hackathon
(rounds, rubric, judges, settings)"]
        H2["Event Leads can change deadlines
or postpone while in draft/active"]
    end

    TH5 --> H1
    H1 --> H2

    %% ── Ongoing Platform Management ─────────
    subgraph ONGOING["Ongoing Platform Management"]
        O1[System stats dashboard]
        O2[User management]
        O3[Workspace oversight]
        O4[Hackathon oversight]
        O5[Admin list management]
        O6[Audit hash backfill]
        O7["Intervene: fix issues,
override states, debug pipelines"]
    end

    P2 --> ONGOING

    %% ── Styling ─────────────────────────────
    classDef provision fill:#1e1e2e,stroke:#f9e2af,color:#cdd6f4
    classDef review fill:#1e1e2e,stroke:#f38ba8,color:#cdd6f4
    classDef theme fill:#1e1e2e,stroke:#cba6f7,color:#cdd6f4
    classDef handoff fill:#1e1e2e,stroke:#89b4fa,color:#cdd6f4
    classDef ongoing fill:#1e1e2e,stroke:#fab387,color:#cdd6f4

    class PROVISION provision
    class REVIEW review
    class THEME theme
    class HANDOFF handoff
    class ONGOING ongoing
