---
title: "Event Lead(s) — Hackathon Organizer User Flow"
---

flowchart TD
    %% ── Onboarding ─────────────────────────
    subgraph ONBOARD["Onboarding"]
        O1[Receive invite from Workspace Admin]
        O2[Click invite → platform.devsage.org]
        O3[Sign up / Log in]
        O4[Accept hackathon invite]
    end

    O1 --> O2 --> O3 --> O4

    %% ── Configuration ──────────────────────
    subgraph CONFIG["Configure — Draft Phase"]
        CF1["Set Up Rounds
(name, deadlines)"]
        CF2["Define Rubric per round —
weighted scoring"]
        CF3["Invite Judges
(invite link or create account)"]
        CF4["Configure Settings
(registration, tags, repo, timezone)"]
        CF5["Configure Theming
(logo, colors, copy)"]
        CF6[Pre-event Announcements]
    end

    O4 --> CONFIG

    %% ── Participant Seeding (Private) ──────
    subgraph SEED["Participant Seeding (Private)"]
        SE1[Upload participant data]
        SE2{"Seeding mode?"}
        SE3["Mode A: Full Structure
(teams + roles pre-defined)"]
        SE4["Mode B: Leaders Only
(leaders recruit members)"]
    end

    CONFIG --> SEED
    SE1 --> SE2
    SE2 -->|A| SE3
    SE2 -->|B| SE4

    %% ── Activation ─────────────────────────
    subgraph ACTIVATE["Activation"]
        A1["Transition: draft → active"]
        A2[Deadline alarm set in Durable Object]
        A3[Participants can register & submit]
    end

    SEED --> A1
    CONFIG --> A1
    A1 --> A2 --> A3

    %% ── Active Monitoring ──────────────────
    subgraph MONITOR["Active Monitoring"]
        M1[Track Teams]
        M2[Review Submissions]
        M3[Post Announcements]
        M4[View Analytics]
        M5[Track Leaderboard]
        M6[View Audit Log]
    end

    A3 --> MONITOR

    %% ── Judging Phase ──────────────────────
    subgraph JUDGING["Judging Phase"]
        J1["Transition: active → judging"]
        J2["Assign judges to submissions
(handle COI reassignments)"]
        J3[Monitor scoring progress]
    end

    MONITOR --> J1 --> J2 --> J3

    %% ── Multi-Round Cycle ──────────────────
    subgraph ROUNDS["Multi-Round Cycle"]
        MR1[Publish round results]
        MR2{"Eliminate
teams?"}
        MR3["Select advancing teams"]
        MR4["Eliminated teams — view only"]
        MR5["All teams proceed"]
        MR6{More rounds?}
        MR7[Continuing teams → next round]
    end

    J3 --> MR1 --> MR2
    MR2 -->|Yes| MR3 --> MR4
    MR3 --> MR6
    MR2 -->|No| MR5 --> MR6
    MR6 -->|Yes| MR7 --> MONITOR
    MR6 -->|No| COMPLETE

    %% ── Completion ─────────────────────────
    subgraph COMPLETE["Completion"]
        CO1["Transition: judging → completed"]
        CO2[Publish final results]
        CO3["Optional: archive later"]
        CO4["Can un-archive if needed"]
    end

    CO1 --> CO2 --> CO3 --> CO4

    %% ── Styling ─────────────────────────────
    classDef onboard fill:#1e1e2e,stroke:#f9e2af,color:#cdd6f4
    classDef config fill:#1e1e2e,stroke:#a6e3a1,color:#cdd6f4
    classDef seed fill:#1e1e2e,stroke:#fab387,color:#cdd6f4
    classDef activate fill:#1e1e2e,stroke:#f38ba8,color:#cdd6f4
    classDef monitor fill:#1e1e2e,stroke:#89b4fa,color:#cdd6f4
    classDef judging fill:#1e1e2e,stroke:#cba6f7,color:#cdd6f4
    classDef rounds fill:#1e1e2e,stroke:#fab387,color:#cdd6f4
    classDef complete fill:#1e1e2e,stroke:#f9e2af,color:#cdd6f4

    class ONBOARD onboard
    class CONFIG config
    class SEED seed
    class ACTIVATE activate
    class MONITOR monitor
    class JUDGING judging
    class ROUNDS rounds
    class COMPLETE complete
