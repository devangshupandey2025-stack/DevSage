---
title: "Club VPs — Workspace Manager User Flow"
---

flowchart TD
    %% ── Onboarding ─────────────────────────────
    subgraph ONBOARD["📩 Onboarding"]
        O1[Receive invite from Workspace Owner]
        O2[Click invite → platform.devsage.org]
        O3[Sign up / Log in via Google OAuth]
        O4[Accept workspace invite]
    end

    O1 --> O2 --> O3 --> O4

    %% ── Hackathon Request ──────────────────────
    subgraph REQUEST["📋 Hackathon Request"]
        R1[Navigate to workspace]
        R2["Submit hackathon request
(title, slug, dates, team sizes)"]
        R3[Track request status]
    end

    O4 --> R1 --> R2 --> R3

    %% ── Request Tracking ────────────────────────
    subgraph TRACKING["📦 Request Status"]
        direction LR
        T1([Submitted]) --> T2([Under Review]) --> T3([Approved / Rejected])
    end

    R3 -.-> TRACKING

    %% ── On Approval ────────────────────────────
    subgraph APPROVED["✅ On Approval"]
        A1["Hackathon created in draft state"]
        A2["DevSage team deploys frontend"]
    end

    T3 -.->|Approved| A1 --> A2

    %% ── Staffing ───────────────────────────────
    subgraph STAFF["👥 Hackathon Staffing"]
        S1["Invite Event Leads
(typically 2 student coordinators)"]
        S2[Event Leads accept invite]
        S3["Both have equal, identical permissions"]
        S4["Manager's primary job done —
Event Leads take over day-to-day"]
    end

    A2 --> S1 --> S2 --> S3 --> S4

    %% ── Ongoing Access ─────────────────────────
    subgraph ONGOING["👁️ Ongoing Access (delegates day-to-day)"]
        G1[View hackathon analytics]
        G2[Full hackathon access if needed]
        G3["Oversight — can step in
but delegates to Event Leads"]
    end

    S4 --> ONGOING

    %% ── Styling ─────────────────────────────────
    classDef onboard fill:#1e1e2e,stroke:#f9e2af,color:#cdd6f4
    classDef request fill:#1e1e2e,stroke:#a6e3a1,color:#cdd6f4
    classDef tracking fill:#1e1e2e,stroke:#fab387,color:#cdd6f4
    classDef approved fill:#1e1e2e,stroke:#89b4fa,color:#cdd6f4
    classDef staff fill:#1e1e2e,stroke:#cba6f7,color:#cdd6f4
    classDef ongoing fill:#1e1e2e,stroke:#f38ba8,color:#cdd6f4

    class ONBOARD onboard
    class REQUEST request
    class TRACKING tracking
    class APPROVED approved
    class STAFF staff
    class ONGOING ongoing
