---
title: "Club President(s) — Workspace Owner User Flow"
---

flowchart TD
    %% ── Onboarding ─────────────────────────────
    subgraph ONBOARD["📩 Onboarding"]
        O1[Receive invite email from Platform Admin]
        O2[Click invite → platform.devsage.org]
        O3[Sign up / Log in via Google OAuth]
        O4[Accept workspace invite]
    end

    O1 --> O2 --> O3 --> O4

    %% ── Workspace Setup ────────────────────────
    subgraph SETUP["⚙️ Workspace Setup"]
        S1[Select billing plan — ₹3,999–₹9,999]
        S2[Invite Club VPs as Managers]
        S3[Managers accept invite]
        S4["Primary job done —
Managers take over operations"]
    end

    O4 --> S1 --> S2 --> S3 --> S4

    %% ── Ongoing Access ─────────────────────────
    subgraph ONGOING["👁️ Ongoing Access (delegates day-to-day)"]
        G1[View analytics across all hackathons]
        G2[Full hackathon access if needed]
        G3[Billing management]
        G4["Oversight — can step in
but delegates to Managers & Event Leads"]
    end

    S4 --> ONGOING

    %% ── Delegation Flow ────────────────────────
    subgraph DELEGATE["📋 Delegation"]
        D1["Managers handle:
hackathon requests, invite event leads"]
        D2["Event Leads handle:
configuration, monitoring, judging"]
    end

    S2 -.->|Delegates to| D1
    D1 -.->|Delegates to| D2

    %% ── Styling ─────────────────────────────────
    classDef onboard fill:#1e1e2e,stroke:#f9e2af,color:#cdd6f4
    classDef setup fill:#1e1e2e,stroke:#a6e3a1,color:#cdd6f4
    classDef ongoing fill:#1e1e2e,stroke:#89b4fa,color:#cdd6f4
    classDef delegate fill:#1e1e2e,stroke:#cba6f7,color:#cdd6f4

    class ONBOARD onboard
    class SETUP setup
    class ONGOING ongoing
    class DELEGATE delegate
