{
  "name": "devsage",
  "version": "0.1.0",
  "description": "DevSage platform monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "deploy:api": "pnpm --filter @devsage/api run deploy",
    "deploy:api:secrets": "pnpm --filter @devsage/api run deploy:secrets",
    "deploy:web": "pnpm --filter @devsage/web run deploy",
    "deploy:platform": "pnpm --filter @devsage/platform run deploy",
    "deploy:admin": "pnpm --filter @devsage/admin run deploy",
    "deploy:api:dev": "pnpm --filter @devsage/api run deploy:dev",
    "deploy:web:dev": "pnpm --filter @devsage/web run deploy:dev",
    "generate:hackathons": "node ./scripts/generate-hackathon-pages.js",
    "generate:site": "node ./scripts/generate-hackathon-site.js",
    "deploy:platform:dev": "pnpm --filter @devsage/platform run deploy:dev",
    "deploy:admin:dev": "pnpm --filter @devsage/admin run deploy:dev",
    "prepare": "husky",
    "secrets:staged": "lint-staged -q --allow-empty",
    "secrets:scan": "secretlint --maskSecrets --format compact ."
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    },
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260206.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "secretlint": "^9.3.0",
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "pnpm": "^10.30.1"
  }
}
