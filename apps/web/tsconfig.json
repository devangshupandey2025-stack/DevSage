{
  "extends": "../../packages/config/tsconfig.react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node", "@cloudflare/workers-types"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/App.tsx",
    "src/pages",
    "src/contexts",
    "src/components/dashboard-layout.tsx",
    "src/components/protected-route.tsx",
    "src/__tests__/auth-context.test.tsx"
  ]
}
