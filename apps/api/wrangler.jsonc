{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "account_id": "cf3386ad6d48a38a199781a39b2324ad",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devsage-db",
      "database_id": "dddf6034-11ca-4d49-a838-cd45fbc6bd86",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "716fbff3dd3d4374b11c69540a18dcf0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "devsage-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HACKATHON_SM",
        "class_name": "HackathonStateMachine"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HackathonLifecycleDO", "SubmissionDO"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["HackathonLifecycleDO", "SubmissionDO"],
      "new_sqlite_classes": ["HackathonStateMachine"]
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "github-webhooks",
        "binding": "WEBHOOK_QUEUE"
      },
      {
        "queue": "devsage-notifications",
        "binding": "NOTIFICATION_QUEUE"
      },
      {
        "queue": "devsage-events",
        "binding": "EVENT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "github-webhooks",
        "max_batch_size": 10,
        "max_retries": 3
      },
      {
        "queue": "devsage-notifications",
        "max_batch_size": 10,
        "max_retries": 3
      },
      {
        "queue": "devsage-events",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "api-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devsage-db-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "00000000000000000000000000000000"
        }
      ],
       "queues": {
         "producers": [
           {
             "queue": "github-webhooks-dev",
             "binding": "WEBHOOK_QUEUE"
           },
           {
             "queue": "devsage-notifications-dev",
             "binding": "NOTIFICATION_QUEUE"
           },
           {
             "queue": "devsage-events-dev",
             "binding": "EVENT_QUEUE"
           }
         ],
         "consumers": [
           {
             "queue": "github-webhooks-dev",
             "max_batch_size": 10,
             "max_retries": 3
           },
           {
             "queue": "devsage-notifications-dev",
             "max_batch_size": 10,
             "max_retries": 3
           },
           {
             "queue": "devsage-events-dev",
             "max_batch_size": 10,
             "max_retries": 3
           }
         ]
       },
      "vars": {
        "FRONTEND_URL": "http://localhost:5173",
        "PLATFORM_URL": "http://localhost:5174",
        "ADMIN_URL": "http://localhost:5175"
      }
    }
  }
}
