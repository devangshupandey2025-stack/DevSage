{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "account_id": "cf3386ad6d48a38a199781a39b2324ad",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devsage-db",
      "database_id": "dddf6034-11ca-4d49-a838-cd45fbc6bd86",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "716fbff3dd3d4374b11c69540a18dcf0"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HACKATHON_LIFECYCLE",
        "class_name": "HackathonLifecycleDO"
      },
      {
        "name": "SUBMISSION",
        "class_name": "SubmissionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HackathonLifecycleDO", "SubmissionDO"]
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "github-webhooks",
        "binding": "WEBHOOK_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "github-webhooks",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "github-webhooks-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "api-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devsage-db-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "00000000000000000000000000000000"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "github-webhooks-dev",
            "binding": "WEBHOOK_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "github-webhooks-dev",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "github-webhooks-dlq-dev"
          }
        ]
      },
      "vars": {
        "FRONTEND_URL": "http://localhost:5173"
      }
    }
  }
}
